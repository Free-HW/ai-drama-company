PORT=3001
GIGGLE_BASE_URL=https://giggle.pro
GIGGLE_API_KEY=replace_me
GIGGLE_AUTH_MODE=x-auth
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=1800000

# OpenClaw Gateway — 用于 AI 剧本生成（LLM）
# 获取方式：cat ~/.openclaw/openclaw.json | python3 -c "import json,sys; print(json.load(sys.stdin)['gateway']['auth']['password'])"
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_PASSWORD=replace_me
