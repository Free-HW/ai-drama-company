PORT=3000

# Giggle API
GIGGLE_BASE_URL=https://giggle.pro
GIGGLE_API_KEY=your_giggle_api_key_here
GIGGLE_AUTH_MODE=x-auth

# OpenClaw Gateway（本地 LLM）
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_PASSWORD=your_gateway_password_here

# StoryClaw LLM API（AI 命名，使用 claude-sonnet-4-6）
STORYCLAW_API_URL=https://llm-ap.gqapi.com
STORYCLAW_API_KEY=your_storyclaw_api_key_here

# StoryClaw workspace sync（迁移文件自动同步）
# 如需自动导入已有项目，填入你的 StoryClaw Workspace Auth Token
# 获取方式： storyclaw.com → 右上角头像 → Settings → API Tokens → 复制 ws_* token
# 如已安装主 workspace 且启用了 storyclaw-workspace-reporter skill，可不填，会自动读取
STORYCLAW_WORKSPACE_AUTH_TOKEN=ws_your_token_here
# STORYCLAW_WORKSPACE_BASE_URL: 市场安装时自动指向 storyclaw.com，通常无需修改
STORYCLAW_WORKSPACE_BASE_URL=https://storyclaw.com
STORYCLAW_WORKSPACE_SYNC_LIMIT=20

# X2C 平台
X2C_API_KEY=x2c_sk_your_key_here
X2C_API_URL=https://eumfmgwxwjyagsvqloac.supabase.co/functions/v1/open-api

# 轮询配置
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=3600000
